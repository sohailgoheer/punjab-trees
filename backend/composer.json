{
  "name": "treestory/api",
  "type": "project",
  "description": "Conditional Laravel 13 API foundation for TreeStory Phase 00",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^13.17"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5.12",
    "laravel/pint": "^1.27",
    "nunomaduro/collision": "^8.6"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "platform": {
      "php": "8.3.0"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
